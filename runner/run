#!/usr/bin/env bash
# Run runner number $1 for one job, in a fresh container, then exit; systemd (tlk-runner@.service) starts the next.
set -euo pipefail
n=${1:?runner number}
: "${TLK_IMAGE:?}"
lib=/usr/local/lib/tlk-runner

# The job's workspace sits at the same path on the host and in the container, so a step's
# `docker run -v "$PWD:/repo"` (hygiene's actionlint and gitleaks) mounts the right directory.
work=/srv/tlk-runner/$n
rm -rf "$work"
install -d -o 1001 -g 1001 "$work" # the image's runner user

jit=$("$lib/jitconfig" "tlk-$(hostname -s)-$n-$(date +%s)" "$work")
install -d -m 700 /run/tlk-runner
env_file=/run/tlk-runner/$n.env
(umask 077; printf 'ACTIONS_RUNNER_INPUT_JITCONFIG=%s\n' "$jit" >"$env_file")

# - The host's Docker, so jobs can run containers (the socket's group, whatever its id on this host).
# - NET_ADMIN and /dev/net/tun: a job can join the tailnet for itself (tailscale/github-action), the host never does.
# - host.docker.internal: how a job reaches the ports of a service container it started.
exec docker run --rm --name "tlk-runner-$n" \
  --env-file "$env_file" \
  -v /var/run/docker.sock:/var/run/docker.sock --group-add "$(stat -c %g /var/run/docker.sock)" \
  -v "$work:$work" \
  --cap-add NET_ADMIN --device /dev/net/tun \
  --add-host host.docker.internal:host-gateway \
  "$TLK_IMAGE"
