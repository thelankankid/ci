#!/usr/bin/env bash
# Print a single-use runner config (JIT) for the org, minted with the GitHub App's key.
#   jitconfig <runner-name> <work-folder>
# Reads TLK_ORG, TLK_APP_ID, TLK_APP_KEY, TLK_GROUP_ID and TLK_LABELS (comma-separated) from the environment.
# The App needs one permission: organization "Self-hosted runners", read and write. Its key never leaves the host.
set -euo pipefail
name=${1:?runner name}
work=${2:?work folder}
: "${TLK_ORG:?}" "${TLK_APP_ID:?}" "${TLK_APP_KEY:?}" "${TLK_GROUP_ID:?}" "${TLK_LABELS:?}"
api=https://api.github.com

b64url() { openssl base64 -A | tr '+/' '-_' | tr -d '='; }
# curl with the bearer token in a header read from a file descriptor, not on the command line.
gh_api() {
  local token=$1; shift
  curl -fsS --retry 3 \
    -H "Accept: application/vnd.github+json" -H "X-GitHub-Api-Version: 2022-11-28" \
    -H @<(printf 'Authorization: Bearer %s\n' "$token") "$@"
}

# The App's JWT: valid 10 minutes, backdated a minute for clock drift.
now=$(date +%s)
header=$(printf '{"alg":"RS256","typ":"JWT"}' | b64url)
claims=$(printf '{"iat":%d,"exp":%d,"iss":"%s"}' $((now - 60)) $((now + 540)) "$TLK_APP_ID" | b64url)
sig=$(printf '%s.%s' "$header" "$claims" | openssl dgst -sha256 -sign "$TLK_APP_KEY" -binary | b64url)
jwt="$header.$claims.$sig"

installation=$(gh_api "$jwt" "$api/orgs/$TLK_ORG/installation" | jq -er .id)
token=$(gh_api "$jwt" -X POST "$api/app/installations/$installation/access_tokens" | jq -er .token)

body=$(jq -nc --arg name "$name" --arg work "$work" --argjson group "$TLK_GROUP_ID" --arg labels "$TLK_LABELS" \
  '{name: $name, runner_group_id: $group, labels: ($labels | split(",")), work_folder: $work}')
gh_api "$token" -X POST -d "$body" "$api/orgs/$TLK_ORG/actions/runners/generate-jitconfig" | jq -er .encoded_jit_config
