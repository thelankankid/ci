[Unit]
Description=GitHub Actions runner %i (one job per container)
After=docker.service network-online.target
Wants=network-online.target
Requires=docker.service
StartLimitIntervalSec=0

[Service]
EnvironmentFile=/etc/tlk-runner/runner.env
ExecStart=/usr/local/lib/tlk-runner/run %i
ExecStopPost=-/usr/bin/docker rm -f tlk-runner-%i
ExecStopPost=-/usr/bin/rm -f /run/tlk-runner/%i.env
Restart=always
RestartSec=10
TimeoutStopSec=60

[Install]
WantedBy=multi-user.target
