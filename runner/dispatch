#!/usr/bin/env bash
# The runner dispatcher (tlk-dispatch.service). thelankankid is a personal account, so a runner belongs to one repo.
# Every TLK_POLL seconds this looks at the private repos the GitHub App is installed on for queued jobs whose runs-on
# labels are all in TLK_LABELS, and starts a one-job runner for that repo in a fresh container, at most TLK_RUNNERS
# at a time. A runner that has had no job for TLK_IDLE seconds (its job was cancelled) is removed.
#
# Requests carry the last ETag, and an unchanged answer (304) doesn't count against GitHub's rate limit, so polling
# often is cheap. The App's key never leaves the host; each container gets only its own single-use runner config.
set -uo pipefail
: "${TLK_OWNER:?}" "${TLK_APP_ID:?}" "${TLK_APP_KEY:?}" "${TLK_LABELS:?}" "${TLK_RUNNERS:?}" "${TLK_IMAGE:?}"
API=${TLK_API:-https://api.github.com}
POLL=${TLK_POLL:-10}
IDLE=${TLK_IDLE:-600}
REPOS=${TLK_REPOS:-} # space-separated names; empty: every private repo the App is installed on
state=/run/tlk-runner
work_root=/srv/tlk-runner
install -d -m 700 "$state/etag"
install -d -m 755 "$work_root"
labels_json=$(jq -Rc 'split(",")' <<<"$TLK_LABELS")
docker_gid=$(stat -c %g /var/run/docker.sock)
log() { echo "$*" >&2; }

# --- GitHub App auth ---------------------------------------------------------------------------------------------
b64url() { openssl base64 -A | tr '+/' '-_' | tr -d '='; }
app_jwt() {
  local now header claims sig
  now=$(date +%s)
  header=$(printf '{"alg":"RS256","typ":"JWT"}' | b64url)
  claims=$(printf '{"iat":%d,"exp":%d,"iss":"%s"}' $((now - 60)) $((now + 540)) "$TLK_APP_ID" | b64url)
  sig=$(printf '%s.%s' "$header" "$claims" | openssl dgst -sha256 -sign "$TLK_APP_KEY" -binary | b64url) || return 1
  [ -n "$sig" ] || return 1
  printf '%s.%s.%s' "$header" "$claims" "$sig"
}
# curl with the bearer token in a header read from a file descriptor, never on a command line.
curl_gh() {
  local bearer=$1; shift
  curl -sS --max-time 30 -H "Accept: application/vnd.github+json" -H "X-GitHub-Api-Version: 2022-11-28" \
    -H @<(printf 'Authorization: Bearer %s\n' "$bearer") "$@"
}
token="" token_until=0
ensure_token() {
  (($(date +%s) < token_until)) && return 0
  local jwt installation
  jwt=$(app_jwt) || return 1
  installation=$(curl_gh "$jwt" -f "$API/users/$TLK_OWNER/installation" | jq -er .id) || return 1
  token=$(curl_gh "$jwt" -f -X POST "$API/app/installations/$installation/access_tokens" | jq -er .token) || return 1
  token_until=$(($(date +%s) + 3000)) # tokens last an hour
}
api() { ensure_token && curl_gh "$token" -f "$@"; }
# GET with the cached ETag; prints the body (the cached one on 304).
api_get() {
  local url=$1 key code
  key=$state/etag/$(printf '%s' "$url" | sha1sum | cut -c1-40)
  ensure_token || return 1
  local -a cond=()
  [ -s "$key.etag" ] && [ -s "$key.body" ] && cond=(-H "If-None-Match: $(cat "$key.etag")")
  code=$(curl_gh "$token" "${cond[@]}" -o "$key.new" -D "$key.hdr" -w '%{http_code}' "$url") || return 1
  case $code in
    304) cat "$key.body" ;;
    200)
      mv "$key.new" "$key.body"
      sed -n 's/^[Ee][Tt][Aa][Gg]: *\(.*\)\r\{0,1\}$/\1/p' "$key.hdr" | tr -d '\r' >"$key.etag"
      cat "$key.body" ;;
    *) log "GET $url: HTTP $code"; return 1 ;;
  esac
}

# --- What GitHub wants -------------------------------------------------------------------------------------------
repos="" repos_at=0
list_repos() {
  (($(date +%s) - repos_at < 600)) && [ -n "$repos" ] && return 0
  local page=1 out="" chunk
  while :; do
    chunk=$(api_get "$API/installation/repositories?per_page=100&page=$page") || return 1
    out+=$(jq -r '.repositories[] | select(.private) | .name' <<<"$chunk")$'\n'
    [ "$(jq '.repositories | length' <<<"$chunk")" -lt 100 ] && break
    page=$((page + 1))
  done
  if [ -n "$REPOS" ]; then out=$(grep -xF -f <(tr ' ' '\n' <<<"$REPOS") <<<"$out"); fi
  repos=$(grep -v '^$' <<<"$out" | sort -u)
  repos_at=$(date +%s)
}
# Prints "<queued jobs for us> <busy runner names, space-separated>" for a repo.
repo_jobs() {
  local repo=$1 status runs id jobs queued=0 busy=""
  for status in queued in_progress; do
    runs=$(api_get "$API/repos/$TLK_OWNER/$repo/actions/runs?status=$status&per_page=30") || return 1
    for id in $(jq -r '.workflow_runs[].id' <<<"$runs"); do
      jobs=$(api_get "$API/repos/$TLK_OWNER/$repo/actions/runs/$id/jobs?filter=latest&per_page=100") || return 1
      queued=$((queued + $(jq --argjson ours "$labels_json" \
        '[.jobs[] | select(.status == "queued" and (.labels | length) > 0 and (.labels - $ours) == [])] | length' \
        <<<"$jobs")))
      busy+=" $(jq -r '[.jobs[] | select(.status == "in_progress") | .runner_name // empty] | join(" ")' <<<"$jobs")"
    done
  done
  echo "$queued$busy"
}

# --- Runners -----------------------------------------------------------------------------------------------------
ours() { docker ps --filter label=tlk.repo "$@"; }
start_runner() {
  local repo=$1 name work body resp jit id
  name=tlk-$(hostname -s)-$(date +%s)-$BASHPID
  work=$work_root/$name
  # The workspace is at the same path on the host and in the container, so a step's `docker run -v "$PWD:…"`
  # (hygiene's actionlint and gitleaks) mounts the right directory.
  install -d -o 1001 -g 1001 "$work" # the image's runner user
  body=$(jq -nc --arg name "$name" --arg work "$work" --argjson group "${TLK_GROUP_ID:-1}" --argjson labels "$labels_json" \
    '{name: $name, runner_group_id: $group, labels: $labels, work_folder: $work}')
  resp=$(api -X POST -d "$body" "$API/repos/$TLK_OWNER/$repo/actions/runners/generate-jitconfig") || {
    log "$repo: no runner config"; rm -rf "$work"; return 1; }
  jit=$(jq -r .encoded_jit_config <<<"$resp")
  id=$(jq -r .runner.id <<<"$resp")
  # - The host's Docker, so jobs can run containers.
  # - NET_ADMIN and /dev/net/tun: a job can join the tailnet for itself (tailscale/github-action); the host never does.
  # - host.docker.internal: how a job reaches the ports of a service container it started.
  # The config goes in through the environment, not a file or the command line.
  ACTIONS_RUNNER_INPUT_JITCONFIG=$jit docker run -d --rm --name "$name" \
    --label "tlk.repo=$repo" --label "tlk.runner-id=$id" --label "tlk.started=$(date +%s)" \
    -e ACTIONS_RUNNER_INPUT_JITCONFIG \
    -v /var/run/docker.sock:/var/run/docker.sock --group-add "$docker_gid" \
    -v "$work:$work" \
    --cap-add NET_ADMIN --device /dev/net/tun \
    --add-host host.docker.internal:host-gateway \
    "$TLK_IMAGE" >/dev/null || { log "$repo: container didn't start"; rm -rf "$work"; return 1; }
  log "$repo: started $name"
}
# A runner past TLK_IDLE with no job: its job went away (cancelled, or taken by another runner). Remove it.
reap() {
  local busy=$1 now name repo id started
  now=$(date +%s)
  while read -r name repo id started; do
    [ -n "$name" ] || continue
    ((now - started > IDLE)) || continue
    [[ " $busy " == *" $name "* ]] && continue
    log "$repo: $name idle for $((now - started))s, removing"
    docker rm -f "$name" >/dev/null 2>&1
    api -X DELETE "$API/repos/$TLK_OWNER/$repo/actions/runners/$id" >/dev/null || true
  done < <(ours --format '{{.Names}} {{.Label "tlk.repo"}} {{.Label "tlk.runner-id"}} {{.Label "tlk.started"}}')
  # Workspaces whose container is gone.
  local dir
  for dir in "$work_root"/tlk-*; do
    [ -d "$dir" ] || continue
    docker container inspect "$(basename "$dir")" >/dev/null 2>&1 || rm -rf "$dir"
  done
}

# One pass: read every repo's jobs at once (one request at a time per repo took 30-40 s for 8 repos), then start the
# runners this pass needs together, up to the free slots.
poll() {
  list_repos || return 1
  ensure_token || return 1 # before the subshells: a token they refresh wouldn't come back
  local started; started=$(date +%s)
  local dir; dir=$(mktemp -d "$state/poll.XXXXXX")
  local repo
  for repo in $repos; do
    (repo_jobs "$repo" >"$dir/$repo.tmp" && mv "$dir/$repo.tmp" "$dir/$repo") &
  done
  wait

  local out queued busy all_busy="" mine idle need complete=1 free
  local -a want=()
  for repo in $repos; do
    if [ ! -f "$dir/$repo" ]; then complete=0; continue; fi
    out=$(cat "$dir/$repo")
    queued=${out%% *}
    busy=${out#"$queued"}
    all_busy+="$busy"
    ((queued > 0)) || continue
    mine=$(ours --filter "label=tlk.repo=$repo" -q | wc -l)
    # Our containers for this repo not on a job are waiting for one of these.
    idle=$((mine - $(for n in $busy; do [[ $n == tlk-* ]] && echo; done | wc -l)))
    ((idle < 0)) && idle=0
    for ((need = queued - idle; need > 0; need--)); do want+=("$repo"); done
  done
  rm -rf "$dir"

  free=$((TLK_RUNNERS - $(ours -q | wc -l)))
  if ((${#want[@]} > free)); then log "at $TLK_RUNNERS runners; $((${#want[@]} - (free > 0 ? free : 0))) job(s) wait"; fi
  local n=0
  for repo in "${want[@]}"; do
    ((n < free)) || break
    start_runner "$repo" &
    n=$((n + 1))
  done
  wait

  # Only with every repo's jobs in hand: a busy runner missing from the list would look idle.
  ((complete)) && reap "$all_busy"
  local took=$(($(date +%s) - started))
  ((took > 15)) && log "poll took ${took}s"
  return 0
}

log "dispatching for $TLK_OWNER, labels $TLK_LABELS, up to $TLK_RUNNERS runners"
while :; do
  poll || log "poll failed; retrying"
  sleep "$POLL"
done
