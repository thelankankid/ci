[Unit]
Description=Start one-job GitHub Actions runners for queued jobs
After=docker.service network-online.target
Wants=network-online.target
Requires=docker.service

[Service]
EnvironmentFile=/etc/tlk-runner/runner.env
ExecStart=/usr/local/lib/tlk-runner/dispatch
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
